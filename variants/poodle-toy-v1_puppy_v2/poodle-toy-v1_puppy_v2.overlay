/delete-node/ &flash0;

/ {
	zephyr,user {
		digital-pin-gpios =	<&arduino_header 6 GPIO_ACTIVE_HIGH>,
						<&arduino_header 7 GPIO_ACTIVE_HIGH>,
						<&arduino_header 8 GPIO_ACTIVE_HIGH>,
						<&arduino_header 9 GPIO_ACTIVE_HIGH>,
						<&arduino_header 10 GPIO_ACTIVE_HIGH>,
						<&arduino_header 11 GPIO_ACTIVE_HIGH>,
						<&arduino_header 12 GPIO_ACTIVE_HIGH>,
						<&arduino_header 13 GPIO_ACTIVE_HIGH>,
						<&arduino_header 14 GPIO_ACTIVE_HIGH>,
						<&arduino_header 15 GPIO_ACTIVE_HIGH>,
						<&arduino_header 16 GPIO_ACTIVE_HIGH>,
						<&arduino_header 17 GPIO_ACTIVE_HIGH>,
						<&arduino_header 18 GPIO_ACTIVE_HIGH>,
						<&arduino_header 19 GPIO_ACTIVE_HIGH>,
						<&arduino_header 20 GPIO_ACTIVE_HIGH>,
						<&arduino_header 21 GPIO_ACTIVE_HIGH>,
						<&gpio0 23 GPIO_ACTIVE_HIGH>; /* LED_BUILTIN */

		serials = <&uart0>;
		i2cs = <&i2c0>;
		spis = <&spi0>;

        pwms =  <&pwm1 0 PWM_HZ(490) PWM_POLARITY_NORMAL>,
                <&pwm1 1 PWM_HZ(490) PWM_POLARITY_NORMAL>,
                <&pwm1 2 PWM_HZ(490) PWM_POLARITY_NORMAL>,
                <&pwm1 3 PWM_HZ(490) PWM_POLARITY_NORMAL>,
                <&pwm2 0 PWM_HZ(490) PWM_POLARITY_NORMAL>,
                <&pwm2 1 PWM_HZ(490) PWM_POLARITY_NORMAL>;

        pwm-pin-gpios = <&arduino_header 9 GPIO_ACTIVE_HIGH>,
                        <&arduino_header 11 GPIO_ACTIVE_HIGH>,
                        <&arduino_header 12 GPIO_ACTIVE_HIGH>,
                        <&arduino_header 13 GPIO_ACTIVE_HIGH>,
                        <&arduino_header 14 GPIO_ACTIVE_HIGH>,
                        <&arduino_header 15 GPIO_ACTIVE_HIGH>;
	};
};

&spi0 {
    flash0: flash@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <20000000>;
        size = <DT_SIZE_M(8)>;
        status = "okay";

        partitions {
            compatible = "fixed-partitions";
            #size-cells = <1>;
            #address-cells = <1>;

            boot_partition: partition@0 {
                reg = <0 0x20000>;
                label = "boot_partition";
                read-only;
            };

            slot0_partition: partition@20000 {
                reg = <0x20000 0x2C000>;
                label = "slot0";
            };

            user_sketch: partition@4C000 {
                reg = <0x4C000 0x14000>;
				label = "user_sketch";
            };

            storage_partition: partition@60000 {
                reg = <0x60000 0x20000>;
                label = "storage";
            };
        };
    };
};
