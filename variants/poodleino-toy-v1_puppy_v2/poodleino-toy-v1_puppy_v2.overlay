	zephyr,user {
		builtin-led-gpios = <&gpio0 23 0>; //led3
		digital-pin-gpios = <&arduino_header 6 0>,
						<&arduino_header 7 0>,
						<&arduino_header 8 0>,
						<&arduino_header 9 0>,
						<&arduino_header 10 0>,
						<&arduino_header 11 0>,
						<&arduino_header 12 0>,
						<&arduino_header 13 0>,
						<&arduino_header 14 0>,
						<&arduino_header 15 0>,
						<&arduino_header 16 0>,
						<&arduino_header 17 0>,
						<&arduino_header 18 0>,
						<&arduino_header 19 0>,
						<&arduino_header 20 0>,
						<&arduino_header 21 0>;

		serials = <&uart0>;
		i2cs = <&i2c0>;
	};
};
